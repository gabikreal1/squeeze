# Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
# custom_connection = set XERO_AUTH_MODE=custom_connection (omit for Web app OAuth)
# XERO_AUTH_MODE=custom_connection
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback
XERO_SCOPES=accounting.invoices accounting.payments accounting.contacts accounting.settings offline_access
XERO_WEBHOOK_KEY=

# OpenAI (Copilot + AI call dialogue — GPT text replies, not Realtime voice)
OPENAI_API_KEY=

# Twilio (WhatsApp, SMS, Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Outbound voice number (Twilio number that places AI calls)
TWILIO_VOICE_FROM=+442475427196
# Optional: Twilio Content template for outbound WhatsApp (sandbox/prod)
TWILIO_WHATSAPP_CONTENT_SID=
# Optional: override demo debtor number for AI voice calls
# DEMO_CALL_TO=+447512593720

# App
PUBLIC_BASE_URL=            # HTTPS tunnel URL — Twilio voice + Xero webhooks must reach this host
# Voice pipeline: Twilio Gather STT → GPT-4o text → Polly TTS (see GET /api/calls/diagnostics)
SAFETY_BUFFER=2000
DATABASE_PATH=data/squeeze.db
