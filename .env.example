# Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
# custom_connection = set XERO_AUTH_MODE=custom_connection (omit for Web app OAuth)
# XERO_AUTH_MODE=custom_connection
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback
XERO_SCOPES=accounting.invoices accounting.payments accounting.contacts accounting.settings accounting.reports.aged.read accounting.banktransactions accounting.attachments offline_access
XERO_WEBHOOK_KEY=

# OpenAI (agent + TTS)
OPENAI_API_KEY=

# Twilio (WhatsApp, SMS, Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=

# App
PUBLIC_BASE_URL=
SAFETY_BUFFER=2000
DATABASE_PATH=data/squeeze.db
